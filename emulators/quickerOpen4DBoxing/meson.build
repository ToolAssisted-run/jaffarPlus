quickerOpen4DBoxingSubproject = subproject('quickerOpen4DBoxing')

# Getting the quickerOpen4DBoxing dependency (the machine, its input parser)
quickerOpen4DBoxingDependency = quickerOpen4DBoxingSubproject.get_variable('quickerOpen4DBoxingDependency')
emulatorDependencies += quickerOpen4DBoxingDependency

# The player's window
emulatorDependencies += dependency('sdl2')
